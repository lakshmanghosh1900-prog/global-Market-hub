generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String    @id @default(cuid())
  sku          String
  slug         String    @unique
  title        String
  price        Decimal   @db.Decimal(10, 2)
  mrp          Decimal?  @db.Decimal(10, 2)
  brand        String?
  image        String?
  gallery      String[]
  description  String?
  gtin         String?
  affiliateUrl String
  merchant     String    @default("Flipkart")
  inStock      Boolean   @default(true)
  lastSync     DateTime  @default(now())
  category     String

  source       String    @default("flipkart")
  isFixture    Boolean   @default(false)
  oosSince     DateTime?
  missingRuns  Int       @default(0)
  isDelisted   Boolean   @default(false)
  duplicateReview Boolean @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  wishlistItems WishlistItem[]
  priceAlerts   PriceAlert[]
  clickEvents   ClickEvent[]

  @@unique([merchant, sku])
  @@index([category, inStock, isDelisted])
  @@index([source, missingRuns])
  @@index([gtin])
}

model Cart {
  id          String     @id @default(cuid())
  userId      String?
  anonymousId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  expiresAt   DateTime
  items       CartItem[]

  @@index([anonymousId])
  @@index([userId])
  @@index([expiresAt])
}

model CartItem {
  id           String   @id @default(cuid())
  cartId       String
  productId    String
  slug         String?
  merchantId   String
  title        String
  price        Decimal  @db.Decimal(10, 2)
  currency     String
  imageUrl     String
  merchantName String
  deepLink     String
  freshness    String
  inStock      Boolean  @default(true)
  createdAt    DateTime @default(now())
  cart         Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId, createdAt])
  @@index([productId])
}

model WishlistItem {
  id          String   @id @default(cuid())
  userId      String?
  sessionId   String
  productId   String
  targetPrice Decimal? @db.Decimal(10, 2)
  addedAt     DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([sessionId, addedAt])
  @@unique([sessionId, productId])
}

model PriceAlert {
  id          String    @id @default(cuid())
  userId      String?
  sessionId   String
  productId   String
  email       String?
  targetPrice Decimal   @db.Decimal(10, 2)
  active      Boolean   @default(true)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, active])
  @@unique([sessionId, productId, targetPrice])
}

model ChatSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  history   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClickEvent {
  id        String   @id @default(cuid())
  productId String?
  merchant  String
  sessionId String?
  targetHost String
  createdAt DateTime @default(now())
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([merchant, createdAt])
}

model IngestRun {
  id            String    @id @default(cuid())
  source        String
  status        String
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  feedFetchedAt DateTime?
  feedCount     Int       @default(0)
  parsedCount   Int       @default(0)
  upserted      Int       @default(0)
  missingChecked Int      @default(0)
  expiredFeeds  Int       @default(0)
  cursor        String?
  error         String?
  createdAt     DateTime  @default(now())

  @@index([source, createdAt])
  @@index([source, status, finishedAt])
}

model Country {
  code              String   @id
  name              String
  active            Boolean  @default(false)
  currency          String   @default("TBD")
  locale            String   @default("en-US")
  launchStatus      String   @default("coming_soon")
  supportedMerchants String[] @default([])
  createdAt         DateTime @default(now())
}

model Merchant {
  slug          String   @id
  name          String
  active        Boolean  @default(false)
  catalogSource String
  createdAt     DateTime @default(now())
}

model TaxonomyTerm {
  slug      String   @id
  name      String
  parent    String?
  createdAt DateTime @default(now())
}

model PriceBracket {
  id        String   @id @default(cuid())
  country   String
  slug      String
  label     String
  maxPrice  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@unique([country, slug])
}

model OfferAlertSubscription {
  id                  String   @id @default(cuid())
  email               String   @unique
  phoneNo             String?
  whatsappNo          String?
  hasWhatsappConsent  Boolean  @default(false)
  consentAt           DateTime
  whatsappConsentAt   DateTime?
  categories          String[]
  priceBrackets       String[]
  maxPrice            Decimal? @db.Decimal(10, 2)
  isVerified          Boolean  @default(false)
  verificationToken   String?  @unique
  unsubscribeToken    String?  @unique
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([isActive, isVerified])
}
