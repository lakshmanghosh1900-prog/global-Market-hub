generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String    @id @default(cuid())
  sku          String
  title        String
  price        Decimal   @db.Decimal(10, 2)
  mrp          Decimal?  @db.Decimal(10, 2)
  brand        String?
  image        String?
  affiliateUrl String
  merchant     String    @default("Flipkart")
  inStock      Boolean   @default(true)
  lastSync     DateTime  @default(now())
  category     String

  source       String    @default("flipkart")
  oosSince     DateTime?
  missingRuns  Int       @default(0)
  isDelisted   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([merchant, sku])
  @@index([category, inStock, isDelisted])
  @@index([source, missingRuns])
}
